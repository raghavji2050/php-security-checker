# Free key from https://nvd.nist.gov/developers/request-an-api-key
# Without it, NVD allows about 5 requests per 30 seconds.
NVD_API_KEY=

# Optional. Raises the GitHub API rate limit for php/php-src advisories.
GITHUB_TOKEN=

# Cache lifetimes in seconds.
NVD_CACHE_TTL_SECONDS=21600
PHP_CACHE_TTL_SECONDS=43200

# Optional directory for the on-disk response cache. Defaults to the system temp directory.
# CACHE_DIR=
